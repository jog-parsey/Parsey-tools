<!doctype html>
<html lang="da">
<head>
<meta charset="utf-8">
<style>
@font-face { font-family: 'Space Grotesk'; font-weight: 500; src: url(data:font/woff2;base64,{{ sg_medium }}) format('woff2'); }
@font-face { font-family: 'Space Grotesk'; font-weight: 700; src: url(data:font/woff2;base64,{{ sg_bold }}) format('woff2'); }
@font-face { font-family: 'Inter'; font-weight: 400; src: url(data:font/woff2;base64,{{ inter_reg }}) format('woff2'); }
@font-face { font-family: 'Inter'; font-weight: 600; src: url(data:font/woff2;base64,{{ inter_semi }}) format('woff2'); }

:root {
  --dyb: #0E3B43;
  --sand: #F5F1E8;
  --signal: #31D89C;
  --signal-text: #157A57;
  --blaek: #082226;
  --taage: #5A6B69;
  --display: 'Space Grotesk', Arial, sans-serif;
  --body: 'Inter', Arial, sans-serif;
}

* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
body { font-family: var(--body); color: var(--blaek); background: var(--sand); font-size: 10.3pt; line-height: 1.42; }

.page {
  width: 210mm;
  min-height: 297mm;
  position: relative;
  background: var(--sand);
  page-break-after: always;
  display: flex;
  flex-direction: column;
}
.page:last-child { page-break-after: avoid; }

/* ---- header (page 1 only) ---- */
.header {
  background: var(--dyb);
  color: white;
  padding: 14mm 16mm 10mm 16mm;
}
.logo { font-family: var(--display); font-weight: 700; font-size: 15pt; color: white; letter-spacing: -0.01em; }
.logo .u { color: var(--signal); }
.header-main { display: flex; gap: 8mm; align-items: flex-start; margin-top: 9mm; }
.photo {
  width: 26mm; height: 26mm; border-radius: 4mm; object-fit: cover; background: #2c5a63; flex-shrink: 0;
}
.name-block { padding-top: 1mm; }
.name { font-family: var(--display); font-weight: 700; font-size: 21pt; line-height: 1.15; color: white; margin: 0 0 2mm 0; }
.role { font-family: var(--body); font-weight: 600; font-size: 11.5pt; color: var(--signal); margin: 0; }

.meta-strip {
  margin-top: 8mm; padding-top: 6mm; border-top: 1px solid rgba(255,255,255,0.18);
  display: flex; gap: 11mm;
}
.meta-item .meta-label { font-family: var(--body); font-weight: 600; font-size: 6.6pt; letter-spacing: 0.12em; text-transform: uppercase; color: var(--signal); margin-bottom: 1.3mm; }
.meta-item .meta-value { font-family: var(--body); font-weight: 400; font-size: 9.3pt; color: white; white-space: nowrap; }

/* ---- body ---- */
.body { padding: 10mm 16mm 0 16mm; flex: 1; }
.section { margin-bottom: 6mm; }
.section-title {
  font-family: var(--body); font-weight: 600; font-size: 8.3pt; letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--signal-text); border-bottom: 1.4px solid var(--signal); padding-bottom: 2mm; margin-bottom: 3mm;
}
.section-title.page-top { margin-top: 0; }
p.profile-p { margin: 0 0 3mm 0; font-size: 10.3pt; color: var(--blaek); }
p.profile-p:last-child { margin-bottom: 0; }

.competency-grid { display: grid; grid-template-columns: 1fr 1fr; column-gap: 10mm; }
.competency-item {
  display: flex; align-items: baseline; gap: 2.5mm; padding: 2.6mm 0; border-bottom: 1px solid #E4DFD1; font-size: 9.7pt;
}
.competency-item .dot { color: var(--signal); font-size: 8pt; flex-shrink: 0; }
.competency-item b { font-weight: 600; }

/* ---- footer ---- */
.footer {
  margin-top: auto; padding: 4mm 16mm 8mm 16mm; border-top: 1px solid #DCD6C6;
  display: flex; justify-content: space-between; font-size: 7.3pt; letter-spacing: 0.08em; text-transform: uppercase;
  color: var(--taage); font-weight: 600;
}

/* ---- projects (page 2) ---- */
.project { margin-bottom: 4mm; padding-bottom: 4mm; border-bottom: 1px solid #E4DFD1; }
.project:last-child { border-bottom: none; }
.project-head { display: flex; justify-content: space-between; align-items: baseline; }
.project-title { font-family: var(--body); font-weight: 600; font-size: 11pt; color: var(--blaek); }
.project-year { font-family: var(--body); font-weight: 600; font-size: 8.8pt; color: var(--taage); }
.project-role { font-family: var(--body); font-weight: 600; font-size: 9.1pt; color: var(--signal-text); margin: 0.8mm 0 2mm 0; }
.project-situation { font-size: 9.6pt; margin: 0 0 2mm 0; }
.project-bullets { margin: 0 0 2mm 0; padding: 0; list-style: none; }
.project-bullets li { position: relative; padding-left: 4mm; margin-bottom: 1mm; font-size: 9.4pt; }
.project-bullets li::before { content: '\2022'; color: var(--signal); position: absolute; left: 0; }
.project-result { font-size: 9.7pt; }
.project-result .result-label { font-weight: 700; font-size: 7.6pt; letter-spacing: 0.1em; text-transform: uppercase; color: var(--signal-text); margin-right: 2mm; }
.result-todo { background: rgba(49,216,156,0.14); border: 1px dashed var(--signal); border-radius: 1.5mm; padding: 0.5mm 2mm; font-style: italic; color: var(--taage); }

/* ---- job history / education (page 3) ---- */
.job-row { display: grid; grid-template-columns: 24mm 1fr; gap: 4mm; padding: 3mm 0; border-bottom: 1px solid #E4DFD1; }
.job-row:last-child { border-bottom: none; }
.job-years { font-size: 9pt; font-weight: 600; color: var(--taage); }
.job-role { font-weight: 600; font-size: 10.3pt; }
.job-company { font-size: 9.5pt; color: var(--taage); margin-bottom: 1.5mm; }
.job-bullets { margin: 0; padding: 0; list-style: none; }
.job-bullets li { position: relative; padding-left: 4mm; margin-bottom: 1mm; font-size: 9.5pt; }
.job-bullets li::before { content: '\2022'; color: var(--signal); position: absolute; left: 0; }

.edu-grid { display: grid; grid-template-columns: 1fr 1fr; column-gap: 10mm; }
.edu-item { padding: 2mm 0; }
.edu-years { font-size: 8.8pt; font-weight: 600; color: var(--taage); }
.edu-degree { font-weight: 600; font-size: 10pt; }
.edu-field { font-size: 9.5pt; color: var(--taage); }

.cert-todo { font-style: italic; color: var(--taage); background: rgba(49,216,156,0.14); border: 1px dashed var(--signal); border-radius: 1.5mm; padding: 1.5mm 3mm; display: inline-block; font-size: 9.3pt; }
.clearance-line { margin: 0 0 2mm 0; font-size: 9.5pt; }
</style>
</head>
<body>

<!-- PAGE 1 -->
<div class="page">
  <div class="header">
    <div class="logo">parsey<span class="u">_</span></div>
    <div class="header-main">
      {% if photo_b64 %}<img class="photo" src="data:image/jpeg;base64,{{ photo_b64 }}">{% else %}<div class="photo"></div>{% endif %}
      <div class="name-block">
        <p class="name">{{ navn }}</p>
        <p class="role">{{ rolle }}</p>
      </div>
    </div>
    <div class="meta-strip">
      <div class="meta-item"><div class="meta-label">Erfaring</div><div class="meta-value">{{ erfaring }}</div></div>
      <div class="meta-item"><div class="meta-label">Opstart</div><div class="meta-value">{{ opstart }}</div></div>
      <div class="meta-item"><div class="meta-label">Baseret i</div><div class="meta-value">{{ baseret_i }}</div></div>
      <div class="meta-item"><div class="meta-label">Sprog</div><div class="meta-value">{{ sprog }}</div></div>
      <div class="meta-item"><div class="meta-label">Kontakt</div><div class="meta-value">{{ kontakt }}</div></div>
    </div>
  </div>
  <div class="body">
    <div class="section">
      <div class="section-title page-top">Profil</div>
      {% for p in profil %}<p class="profile-p">{{ p }}</p>{% endfor %}
    </div>
    <div class="section">
      <div class="section-title">Kernekompetencer</div>
      <div class="competency-grid">
        {% for c in kernekompetencer %}
        <div class="competency-item"><span class="dot">&#9679;</span><span><b>{{ c.bold }}</b>{% if c.rest %} {{ c.rest }}{% endif %}</span></div>
        {% endfor %}
      </div>
    </div>
  </div>
  <div class="footer"><span>Parsey &middot; CV &middot; {{ navn_footer }}</span><span>1 / {{ total_pages }}</span></div>
</div>

<!-- PAGE 2 -->
<div class="page">
  <div class="body" style="padding-top: 11mm;">
    <div class="section">
      <div class="section-title page-top">Projektbeskrivelser</div>
      {% for proj in projekter %}
      <div class="project">
        <div class="project-head">
          <div class="project-title">{{ proj.titel }}{% if proj.kunde %} &middot; {{ proj.kunde }}{% endif %}</div>
          <div class="project-year">{{ proj.periode }}</div>
        </div>
        <div class="project-role">{{ proj.rolle }} &middot; {{ proj.virksomhed }}</div>
        <p class="project-situation">{{ proj.situation }}</p>
        <ul class="project-bullets">{% for b in proj.bullets %}<li>{{ b }}</li>{% endfor %}</ul>
        <p class="project-result"><span class="result-label">Resultat</span>{% if proj.resultat_kendt %}{{ proj.resultat }}{% else %}<span class="result-todo">{{ proj.resultat }}</span>{% endif %}</p>
      </div>
      {% endfor %}
    </div>
  </div>
  <div class="footer"><span>Parsey &middot; CV &middot; {{ navn_footer }}</span><span>2 / {{ total_pages }}</span></div>
</div>

<!-- PAGE 3 -->
<div class="page">
  <div class="body" style="padding-top: 14mm;">
    <div class="section">
      <div class="section-title page-top">Joberfaring</div>
      {% for job in joberfaring %}
      <div class="job-row">
        <div class="job-years">{{ job.periode }}</div>
        <div>
          <div class="job-role">{{ job.rolle }}</div>
          <div class="job-company">{{ job.virksomhed }}</div>
          {% if job.bullets %}<ul class="job-bullets">{% for b in job.bullets %}<li>{{ b }}</li>{% endfor %}</ul>{% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
    <div class="section">
      <div class="section-title">Uddannelse</div>
      <div class="edu-grid">
        {% for e in uddannelse %}
        <div class="edu-item">
          <div class="edu-years">{{ e.periode }}</div>
          <div class="edu-degree">{{ e.grad }}</div>
          <div class="edu-field">{{ e.felt }}</div>
          <div class="edu-field">{{ e.sted }}</div>
        </div>
        {% endfor %}
      </div>
    </div>
    <div class="section">
      <div class="section-title">Kurser og certificeringer</div>
      {% if sikkerhedsgodkendelse and sikkerhedsgodkendelse.status == "godkendt" %}
      <p class="clearance-line"><b>Sikkerhedsgodkendelse:</b> {{ sikkerhedsgodkendelse.niveau }}{% if sikkerhedsgodkendelse.udloeber %} (gyldig til {{ sikkerhedsgodkendelse.udloeber }}){% endif %}</p>
      {% endif %}
      {% if cert_lines %}
        <ul class="job-bullets">{% for k in cert_lines %}<li>{{ k }}</li>{% endfor %}</ul>
      {% else %}
        <span class="cert-todo">{{ kurser_todo }}</span>
      {% endif %}
    </div>
  </div>
  <div class="footer"><span>Parsey &middot; CV &middot; {{ navn_footer }}</span><span>3 / {{ total_pages }}</span></div>
</div>

</body>
</html>
